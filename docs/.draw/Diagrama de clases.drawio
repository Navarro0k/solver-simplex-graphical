        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome true\nskinparam shadowing false\nskinparam linetype ortho\n\nclass ControladorProgramacionLineal {\n    - view: MainView\n    + __init__(root: tk.Tk)\n    + resolver_problema(c_obj: list, rest: list, opt_type: str, metodo: str)\n}\n\nclass MainView {\n    - root: tk.Tk\n    - resolver_callback: Callable\n    - num_variables: tk.IntVar\n    - metodo_solucion: tk.StringVar\n    - tipo_optimizacion: tk.StringVar\n    - entradas_objetivo: list\n    - filas_restricciones: list\n    - pasos_ui: list\n    - paso_actual: int\n    - frame_formulario: ttk.Frame\n    - panel_grafico: ttk.Frame\n    - texto_explicacion: tk.Text\n    + __init__(root: tk.Tk, resolver_callback: Callable)\n    - _configurar_estilos()\n    - _construir_interfaz()\n    - _crear_scroll(padre)\n    - _crear_tarjeta(titulo)\n    - _crear_seccion_variables()\n    - _crear_seccion_objetivo()\n    - _crear_seccion_restricciones()\n    - _crear_seccion_metodo()\n    - _crear_entradas_variables(contenedor, valores_defecto)\n    - _crear_fila_desplazable(padre, alto)\n    - _regenerar_formulario(cargar_defecto)\n    - _agregar_fila_restriccion(coefs, signo, cte_val)\n    - _quitar_fila_restriccion(fila)\n    - _construir_panel_derecho(padre)\n    - _leer_datos(): tuple\n    - _preparar_resolucion()\n    + cargar_pasos(pasos: list)\n    - _avanzar_paso()\n    - _renderizar_canvas(fig)\n    + limpiar_resultados()\n    + mostrar_error(titulo: str, mensaje: str)\n}\n\nclass LinearProblem {\n    + objective_coefficients: list\n    + restrictions: list\n    + optimization_type: str\n    + __init__(objective_coefficients: list, restrictions: list, optimization_type: str)\n}\n\nclass GraphicSolver {\n    + problem: LinearProblem\n    + optimization_type: str\n    + vertices: list\n    + best_value: tuple\n    + c1: float\n    + c2: float\n    + restrictions: list\n    + __init__(problem: LinearProblem)\n    + resolver()\n    - _find_vertices()\n    - _calculate_optimal()\n    - _plot_solution(): Figure\n    + obtener_pasos_ui(): list\n}\n\nclass SimplexModel {\n    + problem: LinearProblem\n    + num_restricciones: int\n    + num_variables: int\n    + objective_coefficients: list\n    + tableau: ndarray\n    + variables_basicas: list\n    + historial: list\n    + nombres: list\n    + __init__(problem: LinearProblem)\n    - _construir_matriz_y_nombres(restrictions: list)\n    - _inicializar_fila_z()\n    - _encontrar_columna_pivote(): int\n    - _encontrar_fila_pivote(columna_pivote: int): int\n    - _ejecutar_pivote(fila_pivote: int, columna_pivote: int)\n    - _guardar_estado(pivote: tuple)\n    + resolver(): list\n    + obtener_pasos_ui(): list\n}\n\nclass SimplexModelGranM {\n    + problem: LinearProblem\n    + objective_coefficients: list\n    + optimization_type: str\n    + num_variables: int\n    + num_restricciones: int\n    + num_holguras_o_excesos: int\n    + num_artificiales: int\n    + tableau: ndarray\n    + variables_basicas: list\n    + historial: list\n    + nombres: list\n    + costo_numero: list\n    + costo_M: list\n    + __init__(problem: LinearProblem)\n    - _armar_tabla_inicial(restrictions: list)\n    - _calcular_zj(matriz: ndarray, basicas: list): tuple\n    - _calcular_cj_menos_zj(zj_numero: list, zj_M: list): tuple\n    - _elegir_columna_pivote(diferencia_numero: list, diferencia_M: list): int\n    - _elegir_fila_pivote(columna_pivote: int): int\n    - _pivotear(fila_pivote: int, columna_pivote: int)\n    - _guardar_estado(pivote: tuple)\n    + resolver(): list\n    + obtener_pasos_ui(): list\n}\n\nControladorProgramacionLineal *-- MainView\nControladorProgramacionLineal ..&gt; LinearProblem : &lt;&lt;instancia&gt;&gt;\nControladorProgramacionLineal ..&gt; GraphicSolver : &lt;&lt;instancia&gt;&gt;\nControladorProgramacionLineal ..&gt; SimplexModel : &lt;&lt;instancia&gt;&gt;\nControladorProgramacionLineal ..&gt; SimplexModelGranM : &lt;&lt;instancia&gt;&gt;\n\nGraphicSolver o-- LinearProblem\nSimplexModel o-- LinearProblem\nSimplexModelGranM o-- LinearProblem\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XuDRoAuNx-c3R1WiUfUj-508">
